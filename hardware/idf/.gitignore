# ESP-IDF build outputs and downloaded components. None of this belongs in git:
# build/ alone is hundreds of MB, and managed_components/ is re-resolved from
# main/idf_component.yml on the first `idf.py build`.
build/
sdkconfig
sdkconfig.old
managed_components/
dependencies.lock
.devcontainer/

# Host test binary and its macOS dSYM debug-symbol bundle.
tests/test_hid_commands
tests/*.dSYM/
